# Clerk publishable keys are public client configuration, not secrets.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# API origin only. The mobile client appends /api to this value.
# Use an HTTPS API origin in production; for a physical device on local Wi-Fi,
# use your development machine's reachable LAN address.
EXPO_PUBLIC_API_ORIGIN=https://costpilot-production.up.railway.app
