# CostPilot AI Spend Intelligence - Environment Template
# Copy this file to .env and fill in your credentials

# --- Core Platform ---
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=8080

# --- Security ---
ENCRYPTION_KEY=generate-a-64-character-hex-string-for-aes256-encryption
JWT_SECRET=generate-a-jwt-secret-key
SECRET_KEY=generate-a-long-random-string

# --- CORS (comma-separated allowed origins for production) ---
ALLOWED_ORIGINS=https://yourdomain.com

# --- Authentication (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- AI Providers (Direct APIs) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=AIza...

# --- Multi-Cloud Infrastructure (Telemetry) ---
# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BEDROCK_ROLE_ARN=arn:aws:iam::...

# Azure AI / OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# GCP Vertex AI
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_SERVICE_ACCOUNT_JSON_PATH=./gcp-key.json

# --- Business & Profitability (Unit Economics) ---
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Connectivity & Alerts ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- Database & Storage ---
DATABASE_URL=postgresql://user:password@localhost:5432/costpilot
REDIS_URL=redis://localhost:6379

# --- Feature Flags ---
ENABLE_AUTO_PILOT=true
ENABLE_LLM_ROUTER=true
ENABLE_GPU_DETECTOR=true
