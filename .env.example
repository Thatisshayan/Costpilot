# Core CostPilot API configuration. Copy to .env (gitignored).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/costpilot
NODE_ENV=development
PORT=8080

# Use the same Clerk instance as the client publishable keys.
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me
# Optional networkless verification: CLERK_JWT_KEY=<Clerk public PEM>

# Generate locally with: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))"
# Store the resulting key privately; preserve custody across deployments/backups.
ENCRYPTION_KEY=replace_me_with_64_hex_characters
ALLOWED_ORIGINS=http://localhost:5173

# Client builds load their own ignored .env.local files:
# artifacts/ai-tracker: VITE_CLERK_PUBLISHABLE_KEY, VITE_API_ORIGIN
# artifacts/mobile-app: EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY, EXPO_PUBLIC_API_ORIGIN
# GitHub Pages uses repository variables VITE_CLERK_PUBLISHABLE_KEY and VITE_API_ORIGIN.
# Origins contain no /api path. Physical devices need the API's reachable LAN/HTTPS origin.

# Optional approved monitoring: SENTRY_DSN=<dsn>
# Release preflight additionally needs client public variables and PRIVACY_CONTACT_EMAIL.
# Provider automation, AI, payments and telemetry are disabled in the core release.
# Their credentials and feature flags are not required to start this scope.
